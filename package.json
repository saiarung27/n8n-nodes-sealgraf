{
    "name": "n8n-nodes-sealgraf",
    "version": "0.1.3",
    "description": "Sealgraf node for n8n: check spending permission before an agent buys, claim owner approvals, and seal verifiable receipts.",
    "license": "MIT",
    "homepage": "https://sealgraf.com",
    "keywords": [
        "n8n-community-node-package"
    ],
    "author": {
        "name": "Sai Arun Gunuganti",
        "email": "support@sealgraf.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/saiarung27/n8n-nodes-sealgraf.git"
    },
    "scripts": {
        "build": "n8n-node build",
        "build:watch": "tsc --watch",
        "dev": "n8n-node dev",
        "lint": "n8n-node lint",
        "lint:fix": "n8n-node lint --fix",
        "release": "n8n-node release",
        "prepublishOnly": "n8n-node prerelease",
        "test": "npm run build && node --test tests/sealgraf.test.js"
    },
    "files": [
        "dist",
        "!dist/tsconfig.tsbuildinfo"
    ],
    "n8n": {
        "n8nNodesApiVersion": 1,
        "strict": true,
        "credentials": [
            "dist/credentials/SealgrafApi.credentials.js"
        ],
        "nodes": [
            "dist/nodes/Sealgraf/Sealgraf.node.js"
        ]
    },
    "devDependencies": {
        "@n8n/node-cli": "*",
        "eslint": "9.32.0",
        "prettier": "3.6.2",
        "release-it": "^21.1.0",
        "typescript": "5.9.2"
    },
    "peerDependencies": {
        "n8n-workflow": "*"
    }
}
